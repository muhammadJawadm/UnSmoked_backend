{
  "info": {
    "_postman_id": "c1f10e40-ed1c-4b95-a2f0-57155d4948eb",
    "name": "Unsmoked Challenges Module",
    "description": "API endpoints for the new Challenges flow (Creator, Invites, Lobby, Leaderboard)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Challenge (Custom)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"mode\": \"4-player\",\n    \"sourceType\": \"custom\",\n    \"title\": \"Walk 10,000 steps today\",\n    \"category\": \"Fitness\",\n    \"durationDays\": 1,\n    \"boardSize\": 50,\n    \"xpReward\": 100,\n    \"description\": \"First one to hit the goal wins.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/challenge-assignments/create",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "challenge-assignments",
            "create"
          ]
        }
      }
    },
    {
      "name": "1b. Create Challenge (Preset/Template)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"mode\": \"1v1\",\n    \"sourceType\": \"preset\",\n    \"templateId\": \"<INSERT_TEMPLATE_ID>\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/challenge-assignments/create",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "challenge-assignments",
            "create"
          ]
        }
      }
    },
    {
      "name": "1c. Create Challenge (Open link)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"mode\": \"open\",\n    \"sourceType\": \"custom\",\n    \"title\": \"Global Smoke Free Day\",\n    \"durationDays\": 7\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/challenge-assignments/create",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "challenge-assignments",
            "create"
          ]
        }
      }
    },
    {
      "name": "2. Invite Players",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userIds\": [\"<USER_ID_1>\", \"<USER_ID_2>\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/challenge-assignments/{{challenge_id}}/invite",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "challenge-assignments",
            "{{challenge_id}}",
            "invite"
          ]
        }
      }
    },
    {
      "name": "3. Get My Invites (Inbox)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/challenge-assignments/invites?status=pending",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "challenge-assignments",
            "invites"
          ],
          "query": [
            {
              "key": "status",
              "value": "pending"
            }
          ]
        }
      }
    },
